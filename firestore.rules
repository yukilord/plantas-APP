rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Fotografias das plantas (uma por documento, em formato data URL JPEG).
      match /fotos/{plantaId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
                              && request.auth.uid == userId
                              && request.resource.data.keys().hasOnly(['dados'])
                              && request.resource.data.dados is string
                              && request.resource.data.dados.size() < 900000;
      }
    }
  }
}
